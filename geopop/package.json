{
  "name": "geopop",
  "version": "1.0.0",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "data": "node scripts/build-data.mjs",
    "check": "node scripts/check.mjs",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist -r https://github.com/marikalam/apps.git -b gh-pages -e geopop --add",
    "build:ios": "vite build --mode ios && node scripts/copy-ios-assets.mjs && cap sync ios",
    "open:ios": "cap open ios"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "@fontsource/fredoka": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@mintplex-labs/piper-tts-web": "^1.0.5",
    "@supabase/supabase-js": "^2.117.3",
    "d3-geo": "^3.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "topojson-client": "^3.1.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@diffusionstudio/piper-wasm": "^1.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "flag-icons": "^7.5.0",
    "gh-pages": "^6.3.0",
    "vite": "^5.4.21",
    "world-atlas": "^2.0.2",
    "world-countries": "^5.1.0"
  },
  "type": "module",
  "private": true,
  "homepage": "https://marikalam.github.io/apps/geopop",
  "overrides": {
    "onnxruntime-web": "1.30.0"
  }
}
